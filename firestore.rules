rules_version = '2';

// قواعد أمان Firestore لموقع Kitchèra
// النشر: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ملف العميل: يقرأه ويكتبه صاحبه فقط، ولا يستطيع تعديل سجل التعاقدات بنفسه
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'contracts', 'createdAt'])
                    && request.resource.data.get('contracts', []).size() == 0;
      // يُسمح بتحديث البيانات الشخصية، وبإضافة تعاقد واحد فقط في كل مرة (بدون حذف أو تعديل السابق)
      // ملاحظة: أهلية الجائزة يجب اعتمادها يدوياً من الشركة لأن العميل يستطيع إضافة سجل تعاقد
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'phone', 'email', 'contracts'])
                    && (
                         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['contracts'])
                         || (
                              request.resource.data.contracts.size() == resource.data.contracts.size() + 1
                              && request.resource.data.contracts.size() <= 100
                            )
                       );
      allow delete: if false;
    }

    // التعاقدات: العميل يرى ويضيف تعاقداته فقط، ولا يستطيع تعديلها أو حذفها بعد الإضافة
    match /contracts/{contractId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['userId', 'invoiceUrl', 'date', 'createdAt'])
                    && request.resource.data.invoiceUrl is string;
      allow update, delete: if false;
    }

    // التقييمات: أي زائر يقرأ المعتمد فقط، والعميل يكتب تقييماً غير معتمد باسمه
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true;
      allow create: if isSignedIn()
                    && request.resource.data.approved == false
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      // الاعتماد يتم من لوحة Firebase أو Admin SDK
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
